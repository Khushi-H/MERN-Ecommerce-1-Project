{
  "version": 2,
  "builds": [
    { "src": "Ecommerce-backend/index.js", "use": "@vercel/node" },
    { "src": "Ecommerce-frontend/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Ecommerce-backend/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/static/(.*)",
      "dest": "/Ecommerce-frontend/static/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/Ecommerce-frontend/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/Ecommerce-frontend/index.html"
    }
  ]
}
