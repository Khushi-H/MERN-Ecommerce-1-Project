{
  "version": 2,
  "builds": [
    {
      "src": "Ecommerce-backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Ecommerce-frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/Ecommerce-backend/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/Ecommerce-frontend/build/index.html"
    }
  ]
}
